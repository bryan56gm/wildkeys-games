{
  "name": "@wkg/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA de games.wildkeys.io: una ruta por juego, offline-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
