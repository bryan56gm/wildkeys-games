    "@wkg/ui": "workspace:*",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-pwa": "^1",
    "vitest": "^3"
  }
