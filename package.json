{
  "name": "wildkeys-games",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "homepage": "https://games.wildkeys.io",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "node scripts/dev-banner.mjs",
    "build": "pnpm --filter @wkg/web build",
    "preview": "pnpm --filter @wkg/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "lefthook install || true",
    "verifica": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@bryan56gm/harvis-standards": "github:bryan56gm/harvis-standards",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "eslint": "^9",
    "lefthook": "^2.1.6",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
